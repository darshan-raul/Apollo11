+            / sum(rate(http_requests_total{service="booking",method="POST",path="/api/bookings",status=~"2..|5.."}[28d]))
+            and sum(rate(http_requests_total{service="booking",method="POST",path="/api/bookings",status=~"2..|5.."}[28d])) > 0
+        - record: apollo:booking_error_budget_remaining:28d
+          expr: 1 - apollo:booking_error_ratio:28d / 0.005
+        - alert: ApolloBookingErrorBudgetBurn
+          expr: apollo:booking_error_ratio:5m > (14.4 * 0.005) and apollo:booking_error_ratio:1h > (14.4 * 0.005)
+          for: 2m
+          labels: { severity: critical, service: booking }
+          annotations:
+            summary: Booking creation consumes the 99.5 percent error budget at more than 14.4 times the allowed rate
+
 {{- end }}
